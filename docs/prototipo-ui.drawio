        <mxCell id="hNote" value="«Ver» reabre la pantalla de Resultados. La columna Origen distingue si el análisis vino del chat o del formulario." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2" vertex="1" parent="h1">
