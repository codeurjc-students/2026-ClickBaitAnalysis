        <mxCell id="mK2L" value="Limitaciones: caja negra; puede equivocarse al narrar. NO emite el veredicto: este sale de las tools y se muestra en las tarjetas. Prompt de sistema versionado y consultable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="m1">
