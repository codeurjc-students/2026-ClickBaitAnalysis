        <mxCell id="cCardN" value="Tarjeta pintada con el JSON real de la tool" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2" vertex="1" parent="c1">
          <mxGeometry x="480" y="502" width="320" height="24" as="geometry" />
        </mxCell>

        <mxCell id="cA1" value="Es clickbait de FORMA: usa hipérbole («amazing»), referencia vaga («you», «things») y formato listicle. Pero el cuerpo sí corresponde al titular, así que no hay ENGAÑO: no te promete algo que luego no cuenta. Ojo: las señales léxicas están entrenadas con titulares de noticias en inglés." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#CCCCCC;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" vertex="1" parent="c1">
          <mxGeometry x="60" y="562" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cA1N" value="El LLM narra y contrasta; NO emite el veredicto" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#996600;fontStyle=2" vertex="1" parent="c1">
          <mxGeometry x="830" y="562" width="230" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cU2" value="¿Y si lo comparo con el titular impreso?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="c1">
          <mxGeometry x="660" y="662" width="380" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cDots" value="escribiendo..." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;fontStyle=2" vertex="1" parent="c1">
          <mxGeometry x="60" y="710" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="cIn" value="Pregunta en lenguaje natural, pega un titular o pide una noticia..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;spacingLeft=12;fontColor=#999999;" vertex="1" parent="c1">
          <mxGeometry x="40" y="776" width="890" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cSend" value="Enviar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1" vertex="1" parent="c1">
          <mxGeometry x="940" y="776" width="120" height="48" as="geometry" />
        </mxCell>

        <mxCell id="cAnn" value="Las tarjetas se renderizan con el JSON real que devuelve cada tool MCP; el LLM solo narra y contrasta. Si el modelo se equivoca en su frase, la tarjeta lo desmiente: la explicabilidad no depende del LLM. Plan B si el tool-calling del modelo local falla: modo guiado (el backend decide las tools, el LLM solo narra)." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="40" y="850" width="1020" height="66" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

