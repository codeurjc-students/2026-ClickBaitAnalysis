# El sitio, por su nombre. Caddy sirve HTTPS en el 443 y redirige el 80 solo.
#
# El certificado es AUTOFIRMADO y se carga de dos ficheros que viven en la
# máquina, fuera del repositorio y de la imagen. No es lo que se quería: el
# registro CAA de `urjc.es` sólo autoriza a HARICA, así que Let's Encrypt
# responde `403 urn:ietf:params:acme:error:caa — CAA record for urjc.es prevents
# issuance` (medido contra su entorno de pruebas el 2026-09-20). Cifra el
# tráfico, y los equipos donde se instale el certificado además detectan un
# intermediario; el resto verá un aviso.
#
# Pasar a una autoridad de verdad es cambiar SÓLO la línea `tls`: quitarla si
# arreglan el CAA —Caddy usaría Let's Encrypt— o sustituirla por un bloque con
# el ACME de HARICA.
gongarcia.tfg.etsii.urjc.es {
	tls /certificados/certificado.pem /certificados/clave.pem

	# R12.5, un tope al tamaño de la petición. Va aquí porque esto es la puerta:
	# lo que se rechaza en Caddy no llega a ocupar memoria en la API. 1 MB deja
	# sitio de sobra a un titular con el cuerpo de su noticia.
	request_body {
		max_size 1MB
	}

	# `handle_path` quita el prefijo `/api` antes de reenviar: `/api/tools` llega
	# como `/tools`, igual que con `pathRewrite` en proxy.conf.json. Con `handle`
	# llegaría tal cual, y la API respondería 404 a todo.
	handle_path /api/* {
		# `api` es un contrato: el contenedor de la API tiene que llamarse así,
		# y también su servicio en el compose de #164. El 8000 es el puerto de
		# uvicorn DENTRO del contenedor; no hace falta publicarlo.
		reverse_proxy api:8000
	}

	# Lo que no es de la API es la SPA. Si la ruta no es un fichero, se sirve
	# index.html sin cambiar la URL, y el router de Angular decide: así recargar
	# /historial no da 404. Efecto secundario: un .js que no existe también
	# devuelve index.html con 200.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
